subgraph cluster_{{ cluster_id }} {
    tooltip="{{ tooltip }}"
    color = "{{ border_color }}"
    style="{{ cluster_style|default('rounded') }}"
    label = "  {{ label }}"
    labeljust = "l"
    {% if pen_color %}pencolor = "{{ pen_color }}"
    {% endif %}{% if fill_color %}fillcolor = "{{ fill_color }}"
    {% endif %}{% if pen_width %}penwidth = {{ pen_width }}
    {% endif %}{{ content }}
}
